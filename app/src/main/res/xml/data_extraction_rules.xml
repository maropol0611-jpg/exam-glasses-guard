<?xml version="1.0" encoding="utf-8"?>
<!-- 저장한 빈 교실 기록에는 주변 기기의 이름과 주소가 들어 있다. 클라우드 백업과 기기 간 이전 모두에서 제외한다. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
